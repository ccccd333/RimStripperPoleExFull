<?xml version="1.0" encoding="utf-8"?>
<ModMetaData>
    <name>Stripper Pole</name>
    <author>CryptidFarmer</author>
	<url>https://gitgud.io/cryptidfarmer/rimworld-stripper-pole</url>
    <description>This mod adds stripper poles and dance spots. Pawns can do or watch a dance for recreation.</description>
    <supportedVersions>
        <li>1.6</li>
    </supportedVersions>
    <modDependencies>
        <li>
            <packageId>rim.job.world</packageId>
            <displayName>RimJobWorld</displayName>
        </li>
        <li>
            <packageId>c0ffee.rimworld.animations</packageId>
            <displayName>RimWorld Animations</displayName>
        </li>
        <li>
            <packageId>Orion.Hospitality</packageId>
            <displayName>Hospitality</displayName>
        </li>
    </modDependencies>
	<loadAfter>
		<li>rim.job.world</li>
		<li>c0ffee.rimworld.animations</li>
		<li>Orion.Hospitality</li>
	</loadAfter>
    <packageId>cryptidfarmer.stripper</packageId>
</ModMetaData>